# --- Postgres (Railway-Umbau, siehe docs/umbau-railway.md und docs/db.md) ---
DATABASE_URL=               # lokal: postgres://postgres:postgres@localhost:5433/daehler (siehe docker-compose.yml, npm run db:up)
PGSSLMODE=                  # auf Railway: require (verwaltete Postgres-Instanzen verlangen TLS); lokal leer lassen

# --- better-auth (Admin-Login, siehe docs/umbau-railway.md Abschnitt "Login", Phase E2) ---
BETTER_AUTH_SECRET=         # openssl rand -hex 32
BETTER_AUTH_URL=            # lokal: http://localhost:3000, produktiv: die App-URL

# --- Resend (Mailversand) ---
RESEND_API_KEY=
MAIL_TO_OVERRIDE=          # Test: alle Mails hierhin
RESEND_FROM_OVERRIDE=      # Test: ersetzt die Absenderadresse, solange daehler.com bei Resend nicht verifiziert ist (Resend-Testkonto-Standard: onboarding@resend.dev)
ANTHROPIC_API_KEY=         # optional, Posten 3 und Entwurf-Polish
AI_MODEL=                  # optional, überschreibt das Standardmodell für die Extraktion (Posten 3), Standard: claude-sonnet-5
AI_LIVE_TEST=               # 1: tests/ai/live.test.ts führt echte Anthropic-Aufrufe aus (braucht ANTHROPIC_API_KEY), sonst übersprungen
DRAFT_POLISH=               # 1: lib/draft/polish.ts glättet den Antwortentwurf per KI (zusätzlich ANTHROPIC_API_KEY nötig), Standard aus
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Follow-up-Scheduler (Posten 6, siehe lib/followups/scheduler.ts, instrumentation.ts) ---
# Löst fällige Follow-ups innerhalb der App selbst aus (kein separater Cron-Dienst).
# Ohne diese Variable: aktiv nur bei NODE_ENV=production (Tests/lokale Entwicklung
# bleiben ohne Hintergrund-Timer). "0" schaltet ihn immer aus, "1" immer ein.
FOLLOWUP_SCHEDULER=
# Wartezeit bis zum ersten Lauf nach dem Start, in Millisekunden (Standard: 5 Minuten).
# Nur zum Testen nach einem eigenen Produktions-Start sinnvoll (z. B. auf wenige Sekunden
# verkürzen, um den ersten Lauf im Log abzuwarten), auf Railway nicht setzen.
FOLLOWUP_SCHEDULER_INITIAL_DELAY_MS=

# --- scripts/create-admin-users.ts (optional) ---
# Ohne diese Variablen nutzt das Skript lokal den dokumentierten Dev-
# Passwort-Fallback (siehe docs/db.md). Für die Cloud-Instanz zwingend
# setzen.
ADMIN_DAEHLER_PASSWORD=
ADMIN_TRENDINGMEDIA_PASSWORD=
