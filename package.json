{
  "name": "daehler-anfrage-erlebnis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "parse": "tsx scripts/parse-pricelists.ts",
    "import": "tsx scripts/import-pricelists.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/migrate.ts --seed",
    "db:reset": "docker compose down -v && npm run db:up && npm run db:migrate -- --seed",
    "db:admins": "tsx scripts/create-admin-users.ts",
    "cron:followups": "tsx scripts/cron-followups.ts",
    "backup": "bash scripts/backup.sh",
    "mail:test": "tsx scripts/mail-test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "better-auth": "^1.7.5",
    "nanoid": "^6.0.1",
    "next": "15.5.25",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.27.0",
    "tsx": "^4.23.13",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.5.0-beta.13",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
